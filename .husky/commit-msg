#!/bin/sh

commit_msg=$(cat "$1")

# Padrão Conventional Commits: tipo(escopo): descrição com 10+ chars
pattern="^(feat|fix|docs|style|refactor|test|chore|ci|perf|build|revert)(\(.+\))?: .{10,}"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "❌ Mensagem de commit inválida: '$commit_msg'"
  echo ""
  echo "Formato: tipo(escopo): descrição com pelo menos 10 caracteres"
  echo "Tipos: feat, fix, docs, style, refactor, test, chore, ci, perf, build, revert"
  echo ""
  echo "Exemplos:"
  echo "  feat(auth): adicionar refresh token JWT"
  echo "  fix(migrations): tornar migration 004 idempotente"
  echo ""
  exit 1
fi
