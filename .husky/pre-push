#!/bin/sh
# Pre-push — espelha localmente o job "Security Audit" do CI (pip-audit no
# backend Python, audit-ci no frontend). Vulnerabilidades de dependência podem
# surgir a qualquer momento (CVE nova publicada), não só quando o código
# muda — por isso esse gate roda no push, sempre, e não fica preso ao diff
# staged como o scanner de segredos do pre-commit.
set -e

PYB="$(cd backend && pwd)/.venv"
if [ -x "$PYB/Scripts/python" ]; then PY="$PYB/Scripts/python"; elif [ -x "$PYB/bin/python" ]; then PY="$PYB/bin/python"; else PY=python; fi
echo "🔐 Auditoria de dependências (pip-audit) — backend..."
(cd backend && "$PY" -m pip_audit --skip-editable)

if [ -d frontend/node_modules ]; then
  echo "🔐 Auditoria de dependências (audit-ci) — frontend..."
  (cd frontend && npm run --silent audit)
else
  echo "⚠️  frontend/node_modules ausente — rode 'cd frontend && npm install' para habilitar essa checagem."
fi

echo "✅ Pre-push OK — nenhuma vulnerabilidade alta/crítica nova (igual ao gate do CI)."
