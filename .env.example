# Copie para .env e preencha com valores reais (nunca commite o .env real).

DB_NAME=app
DB_USER=app
DB_PASSWORD=troque_esta_senha
DB_HOST_PORT=5432

JWT_SECRET=troque_por_um_valor_aleatorio_longo
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# Canvas (Instructure) — token de acesso gerado em Conta > Configurações > Novo token de acesso.
CANVAS_BASE_URL=https://sua-instituicao.instructure.com
CANVAS_TOKEN=cole_o_token_aqui
# Pasta local onde os dados de cada curso são gravados (padrão: backend/canvas-data).
CANVAS_OUTPUT_DIR=
