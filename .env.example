# Copie para .env e preencha com valores reais (nunca commite o .env real).

# --- Banco (PostgreSQL com pgvector) -------------------------------------------------
DB_NAME=app
DB_USER=app
DB_PASSWORD=troque_esta_senha
DB_HOST_PORT=5432

# --- Segurança -------------------------------------------------------------------------
JWT_SECRET=troque_por_um_valor_aleatorio_longo
JWT_EXPIRES_MINUTES=480
CORS_ORIGIN=http://localhost:5173
# Cadastro de alunos pelo painel. Desligue (false) depois de criar sua conta.
REGISTRO_ABERTO=true
# Chave AES-256 (32 bytes em base64) que cifra o token do Canvas no banco.
# Gere com: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=gere_uma_chave_de_32_bytes_em_base64

# --- Canvas (Instructure) ----------------------------------------------------------------
# A URL e o token de acesso do aluno são informados no painel (Canvas > Conta > Configurações
# > Novo token de acesso). Só use ALLOW_LOCAL_LMS=true com um Canvas local de desenvolvimento.
SYNC_INTERVAL_HOURS=6
MAX_DOWNLOAD_BYTES=209715200
ALLOW_LOCAL_LMS=false

# --- IA ---------------------------------------------------------------------------------------
# Sem ANTHROPIC_API_KEY o sistema sincroniza e indexa, mas o chat com IA fica desligado.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_CHAT=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CONTEXTUAL_RETRIEVAL=true
RAG_MIN_SIMILARITY=0.35

# Embeddings locais via Ollama (ollama pull bge-m3). "hashing" = só para testes/dev rápido.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
OLLAMA_URL=http://localhost:11434

# --- Canais (configure pelo menos um) ----------------------------------------------------------
# Telegram: crie o bot no @BotFather e registre o webhook em /api/v1/webhooks/telegram
# com secret_token = TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta): webhook em /api/v1/webhooks/whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_SUMMARY_TEMPLATE=resumo_diario
