{
  "name": "cbot-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "docker:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.override.yml up -d",
    "docker:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.override.yml down",
    "docker:logs": "docker compose --env-file .env -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.override.yml logs -f",
    "docker:test": "docker compose --env-file .env -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.override.yml exec backend pytest",
    "docker:prod": "docker compose --env-file .env.prod -f infra/docker/docker-compose.prod.yml up -d",
    "lint:backend": "cd backend && python -m ruff check src tests migrations && python -m mypy src",
    "lint:frontend": "cd frontend && npm run lint",
    "format:backend": "cd backend && python -m ruff format src tests migrations",
    "format:frontend": "cd frontend && npm run format",
    "test:backend": "cd backend && python -m pytest --cov",
    "test:frontend": "cd frontend && npm test",
    "audit:backend": "cd backend && python -m pip_audit --skip-editable",
    "audit:frontend": "cd frontend && npm run audit",
    "audit": "npm run audit:backend && npm run audit:frontend"
  },
  "devDependencies": {
    "husky": "^9.0.11"
  }
}
