FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install -e ".[dev]"
COPY . .

EXPOSE 3001
CMD ["uvicorn", "cbot.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "3001", "--reload", "--reload-dir", "src"]
