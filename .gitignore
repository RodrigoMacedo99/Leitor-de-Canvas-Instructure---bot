# Dependências e artefatos de build
node_modules/
frontend/dist/
backend/coverage/
backend/.venv/
backend/*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
.test_run.log

# Arquivos baixados do Canvas (dados pessoais do aluno — nunca versionar)
backend/data/

# Ambiente e segredos
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Scripts/dumps locais de bootstrap — nunca commitar SQL com dado ou hash
# real (lição de um incidente: um _bootstrap_usuario_local.sql com senha em
# comentário quase foi commitado sem querer). Prefixo "_" = "não versionar".
docs/_*.sql
docs/_*.local.*

# Editores e SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# Worktrees de agentes (isolamento de sessão do Claude Code)
.claude/worktrees/
*.egg-info/
